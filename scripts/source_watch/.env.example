# Copy to `scripts/source_watch/.env` (gitignored) or set the same keys in your host / CI / Cursor project secrets.
# Already-set environment variables are never overwritten by the file.

# --- twitterapi.io ---
TWITTERAPI_KEY=

# --- Discord (optional; webhook can stay in config.json instead) ---
# DISCORD_WEBHOOK_URL=

# --- OpenAI-compatible gateway (Fluxnode: chat + images same host) ---
NEWAPI_KEY=
# Same as FLUXNODE_BASE_URL if you prefer that name.
NEWAPI_BASE_URL=https://api.fluxnode.org/v1
NEWAPI_CHAT_MODEL=claude-opus-4-7-thinking
# Optional: JSON object merged into chat + image POST headers (if gateway requires e.g. x-* headers).
# NEWAPI_EXTRA_HEADERS={"X-Custom":"value"}
# If set and invalid for /images/generations, script retries with NEWAPI_KEY.
# If your gateway uses a different key for images than for chat:
# NEWAPI_IMAGE_KEY=
# Optional: full English prompt for every cover (otherwise auto from draft + tweet).
# NEWAPI_IMAGE_PROMPT=
# NEWAPI_IMAGE_MODEL=gpt-image-2
# NEWAPI_IMAGE_SIZE=1024x1024

# --- Typefully ---
TYPEFULLY_API_KEY=
# TYPEFULLY_SOCIAL_SET_ID=
TYPEFULLY_X_USERNAME=GoSailGlobal
TYPEFULLY_PUBLISH_AT=draft
