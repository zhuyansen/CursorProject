# Copy to shell — never commit real values.
# Or copy keys into scripts/source_watch/.env (see .env.example); scripts auto-load it.
#
# --- docs.newapi.pro (OpenAI-compatible) ---
export NEWAPI_KEY="sk-..."
export NEWAPI_BASE_URL="https://docs.newapi.pro/v1"
export NEWAPI_CHAT_MODEL="gpt-4"
# Optional image for Typefully attachment:
# export NEWAPI_IMAGE_MODEL="gpt-image-2"
# export NEWAPI_IMAGE_SIZE="1024x1024"

# --- Typefully (official api.typefully.com) ---
export TYPEFULLY_API_KEY="..."
# export TYPEFULLY_SOCIAL_SET_ID="12345"   # or leave unset to use first list / match username
# export TYPEFULLY_X_USERNAME="GoSailGlobal"
# Save as draft only (default): omit or set draft
# export TYPEFULLY_PUBLISH_AT="now"

export TWITTERAPI_KEY="..."
